# Copy to .env.local. Restart Expo / rebuild the export after changing values.
# Web / iOS Simulator: http://127.0.0.1:8787
# Android Emulator: http://10.0.2.2:8787
# Physical device: http://<computer-LAN-IP>:8787 (API must listen on LAN).
# Published client: https://<API-domain>. No /v1, tokens or bot secrets here.
# Uncomment and choose the address reachable from the target device:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8787
# Public web address used by invitation links (not the API address):
# EXPO_PUBLIC_WEB_URL=http://127.0.0.1:8081
